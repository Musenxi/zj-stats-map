{
  "name": "zj-stats-map",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:check": "python scripts/merge_stats.py --check",
    "data:merge": "python scripts/merge_stats.py",
    "prebuild": "npm run data:check",
    "build": "vite build --manifest",
    "build:check": "npm run build && node scripts/check_bundle.mjs",
    "preview": "vite preview",
    "test": "node --test && python -m unittest discover -s tests -p test_*.py"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "ol": "^10.11.0",
    "papaparse": "^5.7.0"
  }
}
